---
// ─────────────────────────────────────────────────────────────
// SuiteCard → "casa card" (Habitas room-card pattern):
// 4:5 photo → CASA NAME uppercase letterspaced → ONE sensory
// sentence → quiet discover link. No prices, no spec rows.
// ─────────────────────────────────────────────────────────────
import type { Suite } from '@content/punta-ox-ha';
import { ui, localizePath, resolveLocale, type Locale } from '@i18n';

interface Props {
  suite: Suite;
  index?: number;
  variant?: 'standard' | 'feature';   // kept for API compat
  lang?: Locale;
}

const { suite, index, lang } = Astro.props;
const locale = resolveLocale(lang ?? Astro.currentLocale);
const u = ui(locale);

// Compact mono spec row: TYPE · FLOOR · SLEEPS (sleeps normalized to its first segment)
const specLine = [suite.type, suite.floor, suite.sleeps.split('·')[0].trim()].join(' · ');
---

<a href={localizePath(`/suites/${suite.slug}`, locale)} class="group block will-reveal">
  <div class="overflow-hidden bg-cream-deep aspect-casa">
    {suite.comingSoon ? (
      <div class="w-full h-full flex flex-col items-center justify-center text-center px-6">
        <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-mist/70">{u.suite.comingSoonEyebrow}</span>
        <span class="mt-3 font-display text-ink text-xl leading-tight">{u.suite.comingSoonTitle}</span>
      </div>
    ) : (
      <img
        src={suite.hero.src}
        alt={suite.hero.alt}
        loading={index !== undefined && index < 2 ? 'eager' : 'lazy'}
        class="w-full h-full object-cover transition-transform duration-[1400ms] ease-organic group-hover:scale-[1.04]"
      />
    )}
  </div>

  <div class="pt-7 text-center px-2">
    <h3 class="font-body uppercase text-ink text-sm tracking-eyebrow font-normal">
      {suite.name}
    </h3>
    <p class="mt-2.5 font-mono text-[10px] uppercase tracking-[0.16em] leading-5 text-faint">
      {specLine}
    </p>
    <p class="mt-4 font-body font-light text-mist text-[0.9375rem] leading-relaxed max-w-[19rem] mx-auto pretty">
      {suite.essence}
    </p>
    <p class="mt-2.5 font-body font-light text-faint text-[0.8125rem] max-w-[19rem] mx-auto pretty">
      {suite.bestFor}
    </p>
    <span class="link-discover mt-5 !text-[0.65rem] group-hover:!text-coral-deep group-hover:!border-coral">
      {u.suite.discover} {suite.name.replace('Casa ', '')}
    </span>
  </div>
</a>
