---
import BaseLayout from '@layouts/BaseLayout.astro';
import SuiteCard from '@components/SuiteCard.astro';
import { suites as enSuites, booking } from '@content/punta-ox-ha';
import { getContent, ui, localizePath, resolveLocale, type Locale } from '@i18n';
import lodgify from '../../data/lodgify.json';

export function getStaticPaths() {
  return enSuites.map((s) => ({ params: { slug: s.slug } }));
}

const locale = resolveLocale((Astro.props as { lang?: Locale }).lang ?? Astro.currentLocale);
const u = ui(locale);
const { suites } = getContent(locale);
const suite = suites.find((s) => s.slug === Astro.params.slug)!;
const otherSuites = suites.filter((s) => s.slug !== suite.slug).slice(0, 3);
const bookUrl = booking.urls[suite.slug] ?? booking.searchUrl;

// Live Lodgify data (baked at build time by scripts/fetch-lodgify.mjs)
type LodgifyCasa = {
  priceMXN: number | null;
  priceUSD: number | null;
  periods: Array<{ start: string; end: string; available: boolean }>;
};
const live: LodgifyCasa | undefined = (lodgify.casas as Record<string, LodgifyCasa>)[suite.slug];

const rateLine = live?.priceMXN
  ? `${u.suite.from} $${live.priceMXN.toLocaleString()} MXN · ≈ $${live.priceUSD} USD ${u.suite.perNight}`
  : u.suite.onInquiry;

// Availability is deliberately NOT baked into the page (build-time data goes
// stale). We link straight into the casa's live Lodgify calendar instead.
---

<BaseLayout title={suite.name} description={suite.essence} heroNav={true} lang={locale}>
  <!-- Hero -->
  <section class="relative h-[72vh] min-h-[520px] flex items-end overflow-hidden bg-ink">
    {suite.comingSoon ? (
      <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-br from-ink via-ink to-[#2a2622]"></div>
    ) : (
      <Fragment>
        <img
          src={suite.hero.src}
          alt={suite.hero.alt}
          class="absolute inset-0 w-full h-full object-cover ambient-zoom"
          loading="eager"
          fetchpriority="high"
        />
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-black/25"></div>
      </Fragment>
    )}

    <div class="wrap relative pb-14 md:pb-20">
      <p class="eyebrow !text-cream/80">{suite.comingSoon ? u.suite.comingSoonEyebrow : u.home.casasEyebrow}</p>
      <h1 class="mt-4 font-display font-medium text-cream leading-[1.05]" style="font-size: clamp(2.75rem, 6vw, 4.5rem);">
        {suite.name}
      </h1>
      <p class="mt-5 max-w-measure font-body font-light text-cream/90 text-lg">{suite.essence}</p>
    </div>
  </section>

  <!-- Story + facts -->
  <section class="section bg-cream">
    <div class="wrap grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow will-reveal">{u.suite.theStory}</p>
        <p class="mt-7 font-display font-medium text-ink leading-snug pretty will-reveal" style="font-size: clamp(1.375rem, 2.6vw, 1.875rem);">
          {suite.story}
        </p>
      </div>

      <aside class="lg:col-span-4 lg:col-start-9 border-t lg:border-t-0 lg:border-l border-line pt-8 lg:pt-0 lg:pl-10 will-reveal">
        <p class="eyebrow-quiet mb-7">{u.suite.glance}</p>
        <dl class="space-y-5 font-body font-light text-mist text-[0.9375rem]">
          <div><dt class="eyebrow-quiet !text-[0.6rem] mb-1">{u.suite.typeL}</dt><dd>{suite.type} · {suite.floor}</dd></div>
          <div><dt class="eyebrow-quiet !text-[0.6rem] mb-1">{u.suite.sleepsL}</dt><dd>{suite.sleeps}</dd></div>
          <div>
            <dt class="eyebrow-quiet !text-[0.6rem] mb-2">{u.suite.amenitiesL}</dt>
            <dd><ul class="space-y-1.5">{suite.amenities.map((a) => <li>{a}</li>)}</ul></dd>
          </div>
          <div>
            <dt class="eyebrow-quiet !text-[0.6rem] mb-1">{u.suite.rates}</dt>
            <dd>{rateLine}</dd>
          </div>
          <div>
            <dt class="eyebrow-quiet !text-[0.6rem] mb-1">{u.suite.availability}</dt>
            <dd><a href={bookUrl} target="_blank" rel="noopener" class="link-discover !text-[0.65rem]">{u.suite.liveCalendar}</a></dd>
          </div>
        </dl>
        <a
          href={bookUrl}
          target="_blank"
          rel="noopener"
          class="btn-solid w-full mt-9 text-center"
        >{u.suite.book} {suite.name}</a>
        <a href={localizePath(`/contact?suite=${suite.slug}#inquire`, locale)} class="link-discover mt-4 inline-block w-full text-center !text-[0.7rem]">{u.home.inquiryLink}</a>
      </aside>
    </div>
  </section>

  <!-- Gallery -->
  {suite.gallery.length > 0 && (
    <section class="section-tight bg-cream-deep">
      <div class="wrap">
        <p class="eyebrow text-center mb-10">{locale === 'es' ? 'Dentro de' : 'Inside'} {suite.name}</p>
        <div class="grid gap-5 md:gap-8 sm:grid-cols-2">
          {suite.gallery.map((img) => (
            <figure class="will-reveal">
              <div class="aspect-wide overflow-hidden bg-cream">
                <img src={img.src} alt={img.alt} loading="lazy" class="w-full h-full object-cover hover:scale-[1.03] transition-transform duration-[1400ms] ease-organic" />
              </div>
              {img.caption && (
                <figcaption class="mt-3 font-mono text-[11px] uppercase tracking-[0.16em] text-faint">{img.caption}</figcaption>
              )}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Other casas -->
  <section class="section bg-cream">
    <div class="wrap">
      <p class="eyebrow text-center mb-12">{u.suite.otherCasas}</p>
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {otherSuites.map((s, i) => <SuiteCard suite={s} index={i} lang={locale} />)}
      </div>
    </div>
  </section>
</BaseLayout>
