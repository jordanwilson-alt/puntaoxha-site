---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getContent, ui, localizePath, resolveLocale, type Locale } from '@i18n';

const locale = resolveLocale((Astro.props as { lang?: Locale }).lang ?? Astro.currentLocale);
const { areaSections, bearings } = getContent(locale);
const u = ui(locale);
const title = u.pages.area.eyebrow;
const description = u.pages.area.intro;
---

<BaseLayout {title} {description} lang={locale}>
  <!-- Header -->
  <section class="pt-32 md:pt-40 pb-12 md:pb-16">
    <div class="wrap-narrow text-center">
      <p class="text-coral-500 font-medium tracking-wide uppercase text-xs md:text-sm mb-4">
        {u.pages.area.eyebrow}
      </p>
      <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl text-ink-500 tracking-tight balance leading-tight">
        {u.pages.area.title}
      </h1>
      <p class="mt-6 md:mt-8 font-body text-lg md:text-xl text-ink-400 leading-relaxed max-w-2xl mx-auto">
        {u.pages.area.intro}
      </p>
    </div>
  </section>

  <!-- Getting your bearings — distances + neighborhood map (no exact address) -->
  <section class="section-tight bg-cream-deep">
    <div class="wrap grid gap-12 lg:gap-16 lg:grid-cols-12 items-center">
      <div class="lg:col-span-5">
        <p class="eyebrow will-reveal">{bearings.eyebrow}</p>
        <h2 class="mt-5 font-display font-medium text-ink balance will-reveal" style="font-size: clamp(1.75rem, 3vw, 2.5rem);">
          {bearings.title}
        </h2>
        <ul class="mt-9">
          {bearings.items.map((it) => (
            <li class="flex items-baseline justify-between gap-6 py-3.5 border-b border-line/70 will-reveal">
              <span class="font-body font-light text-ink text-[0.9375rem]">{it.place}</span>
              <span class="shrink-0 font-mono text-[10px] uppercase tracking-[0.16em] text-faint">{it.distance}</span>
            </li>
          ))}
        </ul>
        <p class="mt-6 font-body font-light text-faint text-[0.8125rem] will-reveal">{bearings.note}</p>
      </div>
      <div class="lg:col-span-7">
        <div class="aspect-wide overflow-hidden border border-line bg-cream will-reveal">
          <iframe
            src="https://maps.google.com/maps?ll=15.8430,-97.0450&z=15&output=embed"
            title={locale === 'es' ? 'Mapa de La Punta, Puerto Escondido' : 'Map of La Punta, Puerto Escondido'}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="h-full w-full [filter:grayscale(1)_sepia(.14)_saturate(.9)]"
            style="border:0"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- Area sections -->
  <section class="section">
    <div class="wrap">
      <div class="grid gap-6 md:gap-8 sm:grid-cols-2">
        {areaSections.map((sec, i) => (
          <article class="bg-white border border-sand-200 rounded-lg p-7 md:p-8 hover:border-coral-300 transition-colors will-reveal">
            <p class="text-coral-500 font-medium tracking-wide uppercase text-xs mb-3">
              {sec.eyebrow}
            </p>
            <h2 class="font-display font-bold text-xl md:text-2xl text-ink-500 tracking-tight leading-snug">
              {sec.title}
            </h2>
            <p class="mt-4 font-body text-base md:text-lg text-ink-400 leading-relaxed pretty">
              {sec.body}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-coral-500 text-white">
    <div class="wrap-narrow text-center">
      <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight leading-tight balance">
        {u.pages.area.ctaTitle}
      </h2>
      <p class="mt-5 font-body text-lg text-white/95 max-w-2xl mx-auto">
        {u.pages.area.ctaBody}
      </p>
      <div class="mt-8">
        <a href={localizePath('/guide', locale)} class="inline-block bg-white text-coral-700 font-medium px-8 py-4 rounded-md hover:bg-ink-500 hover:text-white transition-colors">
          {u.pages.area.ctaBtn}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
