---
// Private stats page for the Punta Ox Ha' team.
// Reads /stats/data (keyed worker endpoint) client-side; the key
// travels once in the link (?k=...) and is remembered locally.
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Property Pulse" description="Private visitor statistics for puntaoxha.com" lang="en">
  <section class="pt-32 md:pt-40 pb-8">
    <div class="wrap text-center">
      <p class="eyebrow">Property Pulse · El Pulso</p>
      <h1 class="mt-5 font-display font-medium text-ink leading-[1.05]" style="font-size: clamp(2.25rem, 5vw, 3.5rem);">
        Who's visiting the site
      </h1>
      <p class="mt-5 font-body font-light text-mist max-w-measure mx-auto">
        Live numbers for puntaoxha.com, straight from the web servers.
        Refreshes every 10 minutes · Se actualiza cada 10 minutos.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap max-w-4xl mx-auto">

      <!-- locked / error state -->
      <div id="stats-locked" class="hidden text-center border border-line bg-cream-deep px-8 py-16">
        <p class="eyebrow">Private page</p>
        <p class="mt-4 font-body font-light text-mist max-w-measure mx-auto">
          This page only opens from its private link. Use the exact link Jordan sent you
          (it ends in <span class="font-mono text-[0.8em]">?k=…</span>), then bookmark it.
        </p>
      </div>

      <div id="stats-body" class="hidden">
        <!-- headline tiles -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-line border border-line">
          <div class="bg-cream px-6 py-8">
            <p class="eyebrow-quiet !text-[0.6rem]">Visitors · 7 days</p>
            <p id="t-v7" class="mt-3 font-display text-ink" style="font-size: clamp(1.9rem, 3.5vw, 2.6rem);">—</p>
            <p id="t-today" class="mt-1 font-mono text-[10px] uppercase tracking-[0.14em] text-faint">&nbsp;</p>
          </div>
          <div class="bg-cream px-6 py-8">
            <p class="eyebrow-quiet !text-[0.6rem]">Page views · 7 days</p>
            <p id="t-pv7" class="mt-3 font-display text-ink" style="font-size: clamp(1.9rem, 3.5vw, 2.6rem);">—</p>
            <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.14em] text-faint">Páginas vistas</p>
          </div>
          <div class="bg-cream px-6 py-8">
            <p class="eyebrow-quiet !text-[0.6rem]">Visitors · 30 days</p>
            <p id="t-v30" class="mt-3 font-display text-ink" style="font-size: clamp(1.9rem, 3.5vw, 2.6rem);">—</p>
            <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.14em] text-faint">Visitantes del mes</p>
          </div>
          <div class="bg-cream px-6 py-8">
            <p class="eyebrow-quiet !text-[0.6rem]">Data served · 30 days</p>
            <p id="t-gb" class="mt-3 font-display text-ink" style="font-size: clamp(1.9rem, 3.5vw, 2.6rem);">—</p>
            <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.14em] text-faint">Datos servidos</p>
          </div>
        </div>

        <!-- daily visitors chart -->
        <div class="mt-14">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="eyebrow">Daily visitors · last 30 days</h2>
            <span id="c-peak" class="font-mono text-[10px] uppercase tracking-[0.14em] text-faint"></span>
          </div>
          <div class="relative mt-6 border border-line bg-cream px-4 pt-6 pb-2">
            <svg id="chart" viewBox="0 0 720 220" class="w-full h-auto block" role="img" aria-label="Daily unique visitors, last 30 days"></svg>
            <div id="tip" class="hidden absolute z-10 pointer-events-none bg-ink text-cream font-mono text-[11px] px-3 py-2 leading-relaxed"></div>
          </div>
          <details class="mt-3">
            <summary class="font-mono text-[10px] uppercase tracking-[0.14em] text-faint cursor-pointer">View as table · Ver tabla</summary>
            <div class="mt-3 max-h-64 overflow-auto border border-line">
              <table class="w-full text-left font-mono text-[11px] text-mist">
                <thead class="bg-cream-deep text-ink sticky top-0">
                  <tr><th class="px-3 py-2">Date</th><th class="px-3 py-2">Visitors</th><th class="px-3 py-2">Page views</th></tr>
                </thead>
                <tbody id="table-body"></tbody>
              </table>
            </div>
          </details>
        </div>

        <!-- countries -->
        <div class="mt-14">
          <h2 class="eyebrow">Where guests browse from · last 30 days</h2>
          <div id="countries" class="mt-6 space-y-3"></div>
        </div>

        <p class="mt-14 text-center font-mono text-[10px] uppercase tracking-[0.14em] text-faint">
          Private link for the Punta Ox Ha' team · <span id="upd"></span>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  const fmt = (n: number) => n.toLocaleString('en-US');
  const GOLD = '#A07E2B';

  async function boot() {
    const qk = new URLSearchParams(location.search).get('k');
    let key = qk;
    try {
      if (qk) localStorage.setItem('poh_stats_k', qk);
      key = qk || localStorage.getItem('poh_stats_k');
    } catch {}
    if (!key) return $('stats-locked').classList.remove('hidden');

    let data: any = null;
    try {
      const r = await fetch(`/stats/data?k=${encodeURIComponent(key)}`);
      if (r.ok) data = await r.json();
    } catch {}
    if (!data?.days) return $('stats-locked').classList.remove('hidden');
    render(data);
  }

  function render(data: any) {
    $('stats-body').classList.remove('hidden');
    const days: any[] = data.days;
    const today = days[days.length - 1];
    const last7 = days.slice(-7);
    const sum = (a: any[], f: (d: any) => number) => a.reduce((s, d) => s + f(d), 0);

    $('t-v7').textContent = fmt(sum(last7, (d) => d.visitors));
    $('t-pv7').textContent = fmt(sum(last7, (d) => d.pageViews));
    $('t-v30').textContent = fmt(sum(days, (d) => d.visitors));
    $('t-gb').textContent = (sum(days, (d) => d.bytes) / 1e9).toFixed(1) + ' GB';
    $('t-today').textContent = `Today so far: ${fmt(today?.visitors ?? 0)}`;
    $('upd').textContent = 'updated ' + new Date(data.updated).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });

    // ── chart: thin gold bars, rounded data-ends, selective labels ──
    const W = 720, H = 220, PAD_L = 34, PAD_B = 26, PAD_T = 14;
    const plotW = W - PAD_L - 8, plotH = H - PAD_T - PAD_B;
    const max = Math.max(1, ...days.map((d) => d.visitors));
    const step = plotW / days.length;
    const bw = Math.max(6, Math.min(16, step - 2));
    const y = (v: number) => PAD_T + plotH * (1 - v / max);
    const peak = days.reduce((m, d) => (d.visitors > m.visitors ? d : m), days[0]);
    $('c-peak').textContent = `peak ${fmt(peak.visitors)}`;

    let svg = '';
    for (const gv of [max, Math.round(max / 2)]) {
      svg += `<line x1="${PAD_L}" x2="${W - 8}" y1="${y(gv)}" y2="${y(gv)}" stroke="#E7DECF" stroke-width="1"/>`;
      svg += `<text x="${PAD_L - 6}" y="${y(gv) + 3.5}" text-anchor="end" font-size="10" fill="#8A8177" font-family="monospace">${fmt(gv)}</text>`;
    }
    svg += `<line x1="${PAD_L}" x2="${W - 8}" y1="${y(0)}" y2="${y(0)}" stroke="#D9CFBC" stroke-width="1"/>`;
    days.forEach((d, i) => {
      const x = PAD_L + i * step + (step - bw) / 2;
      const h = Math.max(d.visitors > 0 ? 3 : 0, plotH * (d.visitors / max));
      svg += `<path data-i="${i}" d="${roundedBar(x, y(0), bw, h, 4)}" fill="${GOLD}"/>`;
      const dt = new Date(d.date + 'T12:00:00Z');
      if (i % 7 === 0 || i === days.length - 1)
        svg += `<text x="${x + bw / 2}" y="${H - 8}" text-anchor="middle" font-size="10" fill="#8A8177" font-family="monospace">${dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</text>`;
      if (d === peak && peak.visitors > 0)
        svg += `<text x="${x + bw / 2}" y="${y(d.visitors) - 6}" text-anchor="middle" font-size="10" fill="#2A2622" font-family="monospace">${fmt(d.visitors)}</text>`;
    });
    $('chart').innerHTML = svg;

    // hover tooltips
    const tip = $('tip');
    $('chart').addEventListener('pointermove', (e: any) => {
      const t = e.target.closest('[data-i]');
      if (!t) { tip.classList.add('hidden'); return; }
      const d = days[+t.dataset.i];
      tip.innerHTML = `${new Date(d.date + 'T12:00:00Z').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })}<br>${fmt(d.visitors)} visitors · ${fmt(d.pageViews)} views`;
      const box = $('chart').parentElement!.getBoundingClientRect();
      tip.style.left = Math.min(e.clientX - box.left + 12, box.width - 170) + 'px';
      tip.style.top = e.clientY - box.top - 44 + 'px';
      tip.classList.remove('hidden');
    });
    $('chart').addEventListener('pointerleave', () => tip.classList.add('hidden'));

    // table view
    $('table-body').innerHTML = [...days].reverse()
      .map((d) => `<tr class="border-t border-line"><td class="px-3 py-1.5">${d.date}</td><td class="px-3 py-1.5">${fmt(d.visitors)}</td><td class="px-3 py-1.5">${fmt(d.pageViews)}</td></tr>`)
      .join('');

    // countries
    const regionName = (code: string) => { try { return new Intl.DisplayNames(['en'], { type: 'region' }).of(code) || code; } catch { return code; } };
    const cmax = Math.max(1, ...data.countries.map((c: any) => c.requests));
    $('countries').innerHTML = data.countries
      .map((c: any) => `
        <div class="grid grid-cols-[10rem_1fr_4.5rem] items-center gap-4">
          <span class="font-body font-light text-ink text-sm truncate">${regionName(c.name)}</span>
          <div class="h-3 bg-cream-deep"><div class="h-3" style="width:${Math.max(2, (c.requests / cmax) * 100)}%;background:${GOLD}"></div></div>
          <span class="font-mono text-[11px] text-faint text-right">${fmt(c.requests)}</span>
        </div>`)
      .join('');
  }

  function roundedBar(x: number, y0: number, w: number, h: number, r: number) {
    if (h <= 0) return '';
    const rr = Math.min(r, w / 2, h);
    const top = y0 - h;
    return `M ${x} ${y0} V ${top + rr} Q ${x} ${top} ${x + rr} ${top} H ${x + w - rr} Q ${x + w} ${top} ${x + w} ${top + rr} V ${y0} Z`;
  }

  boot();
</script>
