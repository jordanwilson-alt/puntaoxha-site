---
// ─────────────────────────────────────────────────────────────
// SectionLead — H2 display serif + optional sub-paragraph.
// The standard "title block" for every major section.
// ─────────────────────────────────────────────────────────────
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow?: string;
  eyebrowNumber?: string;
  title: string;
  italic?: string;           // Italic emphasis word/phrase inside the title
  body?: string;
  align?: 'left' | 'center';
  size?: 'md' | 'lg';
}

const {
  eyebrow,
  eyebrowNumber,
  title,
  italic,
  body,
  align = 'left',
  size = 'md',
} = Astro.props;

const sizeCls = size === 'lg' ? 'text-3xl md:text-5xl' : 'text-2xl md:text-4xl';
const alignCls = align === 'center' ? 'text-center max-w-3xl mx-auto' : 'max-w-2xl';
---

<header class:list={['will-reveal', alignCls]}>
  {eyebrow && <Eyebrow number={eyebrowNumber} label={eyebrow} />}
  <h2 class:list={['font-display font-medium tracking-tight mt-5 balance', sizeCls]}>
    {italic ? (
      <Fragment>
        {title.split(italic)[0]}
        <em class="not-italic font-normal" style="font-style: italic; font-feature-settings: 'ss01';">
          {italic}
        </em>
        {title.split(italic)[1]}
      </Fragment>
    ) : (
      title
    )}
  </h2>
  {body && (
    <p class="mt-5 md:mt-7 font-body text-base md:text-lg text-ink-400 pretty leading-relaxed max-w-xl">
      {body}
    </p>
  )}
</header>
