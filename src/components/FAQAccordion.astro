---
// ─────────────────────────────────────────────────────────────
// FAQAccordion — mono-labeled questions, soft expand.
// Uses native <details> for a11y + zero JS.
// ─────────────────────────────────────────────────────────────
interface Props {
  items: Array<{ q: string; a: string }>;
}

const { items } = Astro.props;
---

<div class="divide-y divide-sand-300/60 border-y border-sand-300/60">
  {items.map((item, i) => (
    <details class="group" name="faq">
      <summary class="flex items-start justify-between gap-6 py-6 md:py-7 cursor-pointer list-none">
        <span class="flex items-start gap-5 flex-1">
          <span class="font-mono text-[10px] uppercase tracking-widest text-ink-400/60 mt-2 tabular-nums">
            Q{String(i + 1).padStart(2, '0')}
          </span>
          <span class="font-display text-lg md:text-2xl text-ink-500 leading-snug font-medium tracking-tight"
                style="font-feature-settings: 'ss01';">
            {item.q}
          </span>
        </span>
        <span
          aria-hidden="true"
          class="shrink-0 mt-3 w-5 h-5 relative transition-transform duration-500 ease-soft group-open:rotate-45"
        >
          <span class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-px bg-ink-500"></span>
          <span class="absolute inset-y-0 left-1/2 -translate-x-1/2 w-px bg-ink-500"></span>
        </span>
      </summary>
      <div class="pb-8 md:pb-10 md:pl-16">
        <p class="font-body text-base md:text-lg text-ink-400 max-w-2xl pretty leading-relaxed">
          {item.a}
        </p>
      </div>
    </details>
  ))}
</div>
