---
// ─────────────────────────────────────────────────────────────
// SuiteGallery — Embla scroll-snap carousel of suite photos.
// PhotoSwipe lightbox on click. Counter + caption in mono accent.
// ─────────────────────────────────────────────────────────────
interface Props {
  images: Array<{ src: string; alt: string; caption?: string }>;
  suiteName?: string;
}

const { images, suiteName = '' } = Astro.props;
---

<section data-gallery class="relative">
  <!-- Embla viewport -->
  <div class="overflow-hidden" data-embla-viewport>
    <div class="flex gap-3 md:gap-6 cursor-grab active:cursor-grabbing">
      {images.map((img, i) => (
        <figure
          class="shrink-0 w-[85%] md:w-[60%] lg:w-[48%] first:ml-6 md:first:ml-10 last:mr-6 md:last:mr-10"
          data-gallery-slide
          data-index={i}
        >
          <button
            class="block relative w-full aspect-[4/5] overflow-hidden group focus-visible:outline-coral-500"
            data-gallery-trigger
            data-src={img.src}
            data-alt={img.alt}
            type="button"
            aria-label={`Open image ${i + 1} of ${images.length}: ${img.alt}`}
          >
            <img
              src={img.src}
              alt={img.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              class="w-full h-full object-cover photo-editorial transition-transform duration-[1200ms] ease-organic group-hover:scale-[1.03]"
            />
            <span
              aria-hidden="true"
              class="absolute bottom-3 right-3 font-mono text-[10px] tracking-widest uppercase text-bone-50/90 mix-blend-difference"
            >
              View
            </span>
          </button>
          {img.caption && (
            <figcaption class="mt-3 font-mono text-[11px] uppercase tracking-[0.16em] text-ink-400">
              {img.caption}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  </div>

  <!-- Controls + counter -->
  <div class="wrap flex items-center justify-between mt-6 md:mt-8">
    <div class="flex items-center gap-3">
      <button
        type="button"
        data-embla-prev
        aria-label="Previous image"
        class="h-11 w-11 rounded-full border border-ink-500/20 flex items-center justify-center hover:bg-ink-500 hover:text-bone-50 hover:border-ink-500 transition-colors duration-300"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M15 18L9 12L15 6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button
        type="button"
        data-embla-next
        aria-label="Next image"
        class="h-11 w-11 rounded-full border border-ink-500/20 flex items-center justify-center hover:bg-ink-500 hover:text-bone-50 hover:border-ink-500 transition-colors duration-300"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M9 6L15 12L9 18" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
    <div class="font-mono text-xs text-ink-400 tabular-nums tracking-widest" data-gallery-counter>
      01 / {String(images.length).padStart(2, '0')}
    </div>
  </div>
</section>

<script>
  import EmblaCarousel from 'embla-carousel';

  const init = () => {
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
      const viewport = root.querySelector<HTMLElement>('[data-embla-viewport]');
      const counter = root.querySelector<HTMLElement>('[data-gallery-counter]');
      const prev = root.querySelector<HTMLButtonElement>('[data-embla-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-embla-next]');
      const triggers = root.querySelectorAll<HTMLButtonElement>('[data-gallery-trigger]');
      const slideCount = root.querySelectorAll('[data-gallery-slide]').length;

      if (!viewport) return;

      const embla = EmblaCarousel(viewport, {
        loop: false,
        align: 'start',
        containScroll: 'trimSnaps',
        dragFree: false,
      });

      prev?.addEventListener('click', () => embla.scrollPrev());
      next?.addEventListener('click', () => embla.scrollNext());

      embla.on('select', () => {
        const idx = embla.selectedScrollSnap() + 1;
        if (counter) {
          counter.textContent = `${String(idx).padStart(2, '0')} / ${String(slideCount).padStart(2, '0')}`;
        }
      });

      // PhotoSwipe lightbox (lazy-load on first click)
      let lightbox: any = null;
      triggers.forEach((btn, i) => {
        btn.addEventListener('click', async () => {
          if (!lightbox) {
            const { default: PhotoSwipeLightbox } = await import('photoswipe/lightbox');
            await import('photoswipe/style.css' as any).catch(() => {});
            lightbox = new PhotoSwipeLightbox({
              dataSource: Array.from(triggers).map((t) => ({
                src: t.dataset.src!,
                width: 1600,
                height: 2000,
                alt: t.dataset.alt!,
              })),
              pswpModule: () => import('photoswipe'),
              showHideAnimationType: 'fade',
              bgOpacity: 0.95,
            });
            lightbox.init();
          }
          lightbox.loadAndOpen(i);
        });
      });
    });
  };

  init();
  document.addEventListener('astro:after-swap', init);
</script>
