---
import BaseLayout from '@layouts/BaseLayout.astro';
import SuiteCard from '@components/SuiteCard.astro';
import PropertyMap from '@components/PropertyMap.astro';
import GroupStays from '@components/GroupStays.astro';
import { getContent, ui, localizePath, resolveLocale, type Locale } from '@i18n';

const locale = resolveLocale((Astro.props as { lang?: Locale }).lang ?? Astro.currentLocale);
const { suites } = getContent(locale);
const u = ui(locale);
const title = u.pages.suites.eyebrow;
const description = u.pages.suites.intro;
---

<BaseLayout {title} {description} lang={locale}>
  <!-- Header -->
  <section class="pt-32 md:pt-40 pb-12 md:pb-16">
    <div class="wrap-narrow text-center">
      <p class="text-coral-500 font-medium tracking-wide uppercase text-xs md:text-sm mb-4">
        {u.pages.suites.eyebrow}
      </p>
      <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl text-ink-500 tracking-tight balance leading-tight">
        {u.pages.suites.title}
      </h1>
      <p class="mt-6 md:mt-8 font-body text-lg md:text-xl text-ink-400 leading-relaxed max-w-2xl mx-auto">
        {u.pages.suites.intro}
      </p>
    </div>
  </section>

  <!-- Suites grid -->
  <section class="pb-20 md:pb-28">
    <div class="wrap">
      <div class="grid gap-8 md:gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {suites.map((suite, i) => (
          <SuiteCard suite={suite} index={i} lang={locale} />
        ))}
      </div>
    </div>
  </section>

  <!-- Property layout -->
  <PropertyMap lang={locale} />

  <!-- Whole house / groups -->
  <GroupStays lang={locale} />

  <!-- CTA -->
  <section class="section bg-coral-500 text-white">
    <div class="wrap-narrow text-center">
      <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight leading-tight balance">
        {u.pages.suites.ctaTitle}
      </h2>
      <p class="mt-5 font-body text-lg text-white/95 max-w-2xl mx-auto">
        {u.pages.suites.ctaBody}
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href={localizePath('/contact#inquire', locale)} class="bg-white text-coral-700 font-medium px-8 py-4 rounded-md hover:bg-ink-500 hover:text-white transition-colors">
          {u.pages.suites.ctaBtn}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
