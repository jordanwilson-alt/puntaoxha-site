# ─────────────────────────────────────────────────────────────
# PUNTA OX HA — per-client configuration
# Copy to `.env` and fill in.
# EVERYTHING here is PUBLIC_-prefixed on purpose: client-side
# scripts can only read PUBLIC_* vars. Webhook URLs are public
# endpoints by design.
# ─────────────────────────────────────────────────────────────

# ── Site identity ───────────────────────────────────────────
PUBLIC_SITE_NAME="Punta Ox Ha"
PUBLIC_SITE_NAME_FULL="Punta Ox Ha Coastal Apartments"
PUBLIC_SITE_TAGLINE="Our home steps from the surf"
PUBLIC_SITE_LOCATION="La Punta, Puerto Escondido"
PUBLIC_SITE_REGION="Mexico"
PUBLIC_SITE_DOMAIN="puntaoxha.com"
PUBLIC_SITE_LOGO_URL="/brand/logo.svg"
PUBLIC_SITE_LOGO_ALT="Punta Ox Ha"

# ── Hero ────────────────────────────────────────────────────
PUBLIC_HERO_IMAGE_URL="/hero/main.jpg"
# Optional ambient video loop (muted autoplay, image above becomes the poster/fallback).
# Drop the file at public/hero/main.mp4 and set: "/hero/main.mp4"
PUBLIC_HERO_VIDEO_URL=""
PUBLIC_HERO_HEADLINE="Our home steps from the surf."
PUBLIC_HERO_SUBLINE="Six casas around a courtyard oasis in La Punta — for surfers, remote workers, and anyone here to relax and recharge."

# ── Contact + social ────────────────────────────────────────
PUBLIC_WHATSAPP_NUMBER=""
PUBLIC_EMAIL="puntaoxha@gmail.com"
PUBLIC_INSTAGRAM_HANDLE="puntaoxha"
PUBLIC_INSTAGRAM_URL="https://instagram.com/puntaoxha"

# ── n8n webhooks (set after VPS provisioning) ───────────────
PUBLIC_N8N_INQUIRY_WEBHOOK=""
PUBLIC_N8N_CHAT_WEBHOOK=""
PUBLIC_N8N_LEAD_MAGNET_WEBHOOK=""

# ── Features ────────────────────────────────────────────────
PUBLIC_CHAT_ENABLED="false"
